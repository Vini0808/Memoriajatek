<Window x:Class="Memoriajatek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Memoriajatek"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="listBoxTableSize" SelectionChanged="SizePick" Grid.Row="0" Margin="0,0,400,0" />
        <ListBox x:Name="listBoxTableType" SelectionChanged="TypePick" Grid.Row="0" Margin="400,0,0,0" />
        <Button x:Name="ButtonDone" Content="Pálya rajzolása" Click="ButtonClick_TableDraw" Grid.Row="1"/>

        <Grid x:Name="ButtonGrid" Grid.Row="2"/>

    </Grid>
</Window>
